{
  "manifest_version": 3,
  "name": "WatchTogether — Birlikte İzle",
  "version": "0.1.0",
  "description": "Herhangi bir video sitesinde senkron oynat/durdur/sar + sohbet + sesli & kameralı izleme (P2P).",
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "WatchTogether — paneli aç/kapat"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-panel.js"],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-video.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html", "panel.js", "panel.css", "rtc.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
